# ---------------------------------------------------------------------------
# StudyMate environment configuration
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# values. Find these under Supabase Dashboard > Project Settings > API.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project REST URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable ("anon") key. Safe to expose to the browser: it carries no
# privileges of its own and every request it makes is still gated by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Reminder delivery worker (server-only, optional) -----------------------
# In-app reminders need NONE of this: they are delivered by being read, so the
# notification tray works with nothing set here. These are only for pushing
# reminders outward by email.
#
# Both must be set or POST /api/reminders/deliver refuses to run (503) rather
# than claiming reminders it cannot deliver.

# Bypasses RLS entirely -- the worker delivers for every student, so it cannot
# run as any one of them. Never prefix with NEXT_PUBLIC_, never import into a
# client component.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the delivery endpoint, sent as `Authorization: Bearer ...`.
# The endpoint is a public URL; without this anyone could drain the queue.
REMINDER_CRON_SECRET=

# --- Email delivery (optional) ----------------------------------------------
# Leave EMAIL_PROVIDER unset to disable. Reminders addressed to email then stay
# queued and the run summary reports them as unconfigured -- they are never
# marked sent. Supported: resend | none
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Verified sender, e.g. "StudyMate <reminders@yourdomain.com>"
EMAIL_FROM=

# --- Voice transcription (optional) -----------------------------------------
# Leave TRANSCRIPTION_PROVIDER unset to disable transcription. Voice recording,
# storage and playback all work without it; recordings are simply marked
# 'unsupported' rather than pretending a transcript is coming.
# Supported: openai | none
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# --- App --------------------------------------------------------------------
# Public origin, used to build password-reset and email-confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
